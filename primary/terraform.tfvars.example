region                = "us-east-1"
environment           = "prod"
project_name          = "kailash-3tier-aws"
vpc_cidr              = "172.20.0.0/16"
azs                   = ["us-east-1a", "us-east-1b"]
admin_cidr            = "YOUR_PUBLIC_IP/32"
key_name              = "YOUR_US_EAST_1_KEYPAIR"
instance_type         = "t3.micro"
bootstrap_demo_app    = true
frontend_min_size     = 1
frontend_desired_size = 1
frontend_max_size     = 4
backend_min_size      = 1
backend_desired_size  = 1
backend_max_size      = 4
autoscaling_target_cpu = 60

db_username           = "admin"
db_password           = "CHANGE-ME"
db_name               = "mydb"
db_instance_class     = "db.t3.micro"
backup_retention_days = 7
backend_port          = 80
